<%- include('../partials/head', { title: page === 'settings' ? 'Settings' : 'Dashboard' }) %>

<% if (page === 'settings') { %>
  <!-- ============ Halaman Settings (khusus Admin) ============ -->
  <div class="page-head mb-4">
    <div class="kicker">Khusus Admin</div>
    <h1 class="mb-0"><i class="bi bi-gear" aria-hidden="true"></i> Settings</h1>
  </div>
  <div class="card shadow-sm">
    <div class="card-body">
      <h5 class="card-title">Pengaturan Aplikasi</h5>
      <p class="text-muted mb-0">
        Halaman pengaturan ini disediakan sebagai contoh menu khusus Admin.
        Anda dapat mengembangkannya sesuai kebutuhan (mis. ubah profil,
        preferensi tampilan, dll).
      </p>
    </div>
  </div>

<% } else { %>
  <!-- ============ Halaman Utama Dashboard ============ -->
  <div class="page-head mb-4">
    <div class="kicker">Ruang Baca Digital</div>
    <h1 class="mb-1">Selamat datang, <%= user.username %>! 👋</h1>
    <p class="text-muted mb-0">Berikut ringkasan koleksi E-Book Library Anda.</p>
  </div>

  <!-- Kartu ringkasan -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card stat-card border-0 shadow-sm">
        <div class="card-body d-flex align-items-center">
          <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-book"></i></div>
          <div class="ms-3">
            <div class="fs-3 fw-bold"><%= stats.totalBooks %></div>
            <div class="text-muted small">Total Buku</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card stat-card border-0 shadow-sm">
        <div class="card-body d-flex align-items-center">
          <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-people"></i></div>
          <div class="ms-3">
            <div class="fs-3 fw-bold"><%= stats.totalUsers %></div>
            <div class="text-muted small">Total User</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card stat-card border-0 shadow-sm">
        <div class="card-body d-flex align-items-center">
          <div class="stat-icon bg-warning-subtle text-warning"><i class="bi bi-tags"></i></div>
          <div class="ms-3">
            <div class="fs-3 fw-bold"><%= stats.totalGenres %></div>
            <div class="text-muted small">Total Genre</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabel buku terbaru -->
  <div class="card shadow-sm">
    <div class="card-header bg-white fw-semibold">
      <i class="bi bi-clock-history"></i> Buku Terbaru
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>No</th>
              <th>Judul</th>
              <th>Penulis</th>
              <th>Genre</th>
              <th>Tahun</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentBooks.length === 0) { %>
              <tr><td colspan="5" class="text-center text-muted py-4">Belum ada buku.</td></tr>
            <% } else { %>
              <% recentBooks.forEach((book, i) => { %>
                <tr>
                  <td><%= i + 1 %></td>
                  <td><%= book.title %></td>
                  <td><%= book.author %></td>
                  <td><%= book.genre || '-' %></td>
                  <td><%= book.year || '-' %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
