<%- include('../partials/head', { title: 'Books' }) %>

<!-- Header halaman + tombol tambah (Admin saja) -->
<div class="page-head d-flex justify-content-between align-items-end mb-4">
  <div>
    <div class="kicker">Katalog Koleksi</div>
    <h1 class="mb-0"><i class="bi bi-book" aria-hidden="true"></i> Daftar Buku</h1>
  </div>
  <% if (isAdminRole(user.status)) { %>
    <a href="/dashboard/books/create" class="btn btn-primary">
      <i class="bi bi-plus-lg" aria-hidden="true"></i> Tambah Buku
    </a>
  <% } %>
</div>

<div class="card shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>No</th>
            <th>Cover</th>
            <th>Judul</th>
            <th>Penulis</th>
            <th>Genre</th>
            <th>Tahun</th>
            <th class="text-center">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (books.length === 0) { %>
            <tr><td colspan="7" class="text-center text-muted py-4">Belum ada buku. Silakan tambah buku baru.</td></tr>
          <% } else { %>
            <% books.forEach((book, i) => { %>
              <tr>
                <td><%= offset + i + 1 %></td>
                <td>
                  <% if (book.cover_url) { %>
                    <img src="<%= book.cover_url %>" alt="Sampul <%= book.title %>" class="book-cover">
                  <% } else { %>
                    <div class="book-cover book-cover-placeholder" role="img" aria-label="Tidak ada sampul"><i class="bi bi-book" aria-hidden="true"></i></div>
                  <% } %>
                </td>
                <td><%= book.title %></td>
                <td><%= book.author %></td>
                <td><%= book.genre || '-' %></td>
                <td><%= book.year || '-' %></td>
                <td class="text-center text-nowrap">
                  <!-- Detail (semua role) -->
                  <button class="btn btn-info btn-sm" data-bs-toggle="modal" data-bs-target="#detailModal<%= book.id %>"
                          aria-label="Lihat detail <%= book.title %>">
                    <i class="bi bi-eye" aria-hidden="true"></i>
                  </button>
                  <% if (isAdminRole(user.status)) { %>
                    <!-- Edit (Admin) -->
                    <a href="/dashboard/books/edit/<%= book.id %>" class="btn btn-warning btn-sm"
                       aria-label="Edit <%= book.title %>">
                      <i class="bi bi-pencil" aria-hidden="true"></i>
                    </a>
                    <!-- Hapus (Admin) -> form DELETE via method-override -->
                    <form action="/dashboard/books/<%= book.id %>?_method=DELETE" method="POST" class="d-inline"
                          onsubmit="return confirm('Yakin ingin menghapus buku ini?');">
                      <button type="submit" class="btn btn-danger btn-sm" aria-label="Hapus <%= book.title %>"><i class="bi bi-trash" aria-hidden="true"></i></button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal detail buku (dirender di luar <table> agar tidak diangkat parser HTML) -->
<% books.forEach((book) => { %>
  <div class="modal fade" id="detailModal<%= book.id %>" tabindex="-1" aria-labelledby="detailModalLabel<%= book.id %>" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="detailModalLabel<%= book.id %>"><%= book.title %></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
        </div>
        <div class="modal-body">
          <div class="row">
            <div class="col-4">
              <% if (book.cover_url) { %>
                <img src="<%= book.cover_url %>" alt="Sampul <%= book.title %>" class="img-fluid rounded">
              <% } else { %>
                <div class="book-cover book-cover-placeholder w-100" style="height:140px" role="img" aria-label="Tidak ada sampul"><i class="bi bi-book" aria-hidden="true"></i></div>
              <% } %>
            </div>
            <div class="col-8">
              <p class="mb-1"><strong>Penulis:</strong> <%= book.author %></p>
              <p class="mb-1"><strong>Genre:</strong> <%= book.genre || '-' %></p>
              <p class="mb-1"><strong>Tahun:</strong> <%= book.year || '-' %></p>
              <p class="mb-1"><strong>Deskripsi:</strong></p>
              <p class="text-muted"><%= book.description || 'Tidak ada deskripsi.' %></p>
              <% if (book.file_url) { %>
                <a href="<%= book.file_url %>" target="_blank" class="btn btn-sm btn-outline-primary">
                  <i class="bi bi-download"></i> Buka File
                </a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% }) %>

<!-- Pagination -->
<% if (totalPages > 1) { %>
  <nav class="mt-3">
    <ul class="pagination justify-content-center">
      <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
        <a class="page-link" href="/dashboard/books?page=<%= currentPage - 1 %>">Sebelumnya</a>
      </li>
      <% for (let p = 1; p <= totalPages; p++) { %>
        <li class="page-item <%= p === currentPage ? 'active' : '' %>">
          <a class="page-link" href="/dashboard/books?page=<%= p %>"><%= p %></a>
        </li>
      <% } %>
      <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
        <a class="page-link" href="/dashboard/books?page=<%= currentPage + 1 %>">Berikutnya</a>
      </li>
    </ul>
  </nav>
<% } %>

<%- include('../partials/footer') %>
